# The pinned upstream description, read by Tooling/generate-github-api.sh.
# github/rest-api-description has cut no release since v2.1.0 (2022-10-25);
# its descriptions update on main through automated commits, so the pin is a
# commit plus the file's SHA-256.
SPEC_REPO=github/rest-api-description
SPEC_COMMIT=bb754941722779d8a5b3a2f25a5fbb7ce794e1ea
SPEC_COMMIT_DATE=2026-10-17
# REST API version 2022-11-28: the default when a request names none, and
# the one GitHub Enterprise Server releases support.
SPEC_PATH=descriptions/api.github.com/api.github.com.2022-11-28.json
SPEC_SHA256=309e30296b212d220ed143beeba216dbb0df11915daf79ee2ed01e06c6c9a586
