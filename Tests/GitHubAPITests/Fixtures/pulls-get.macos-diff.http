-      | .build/release/git-diff-parser filter build.log --diff - \
+      | .build/release/steward filter build.log --diff - \
           --format github --fail-on error
 ```
 
@@ -135,7 +140,7 @@ server and filter them like any other input:
 curl -sf -u "$SONAR_TOKEN:" \
